[importlinter]
root_package = src
exclude_type_checking_imports = True

[importlinter:contract:no-ground-truth-leak]
name = Downstream stages never see simulator ground truth
type = forbidden
source_modules =
    src.adapters
    src.conformance
    src.fusion
    src.classification
    src.recommendation
    src.output
    src.recordkeeping
forbidden_modules =
    src.simulator.trajectories
    src.simulator.scenario

[importlinter:contract:detection-schema-truth-free]
name = Detection/Heartbeat schema module never depends on the simulator
type = forbidden
source_modules =
    src.adapters.messages
forbidden_modules =
    src.simulator
