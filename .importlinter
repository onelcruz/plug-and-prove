[importlinter]
root_package = src

[importlinter:contract:no-ground-truth-leak]
name = Downstream stages never see simulator ground truth
type = forbidden
   # src.adapters is excluded: adapters legitimately import src.simulator.detections, which
   # imports trajectories. Revisit once #6 decides where RawDetection/Detection live.
source_modules =
    src.conformance
    src.fusion
    src.classification
    src.recommendation
    src.output
    src.recordkeeping
forbidden_modules =
    src.simulator.trajectories
    src.simulator.scenario
